<%- include('../partials/header', { titulo: titulo }) %>

<h1 class="mb-4"><%= titulo %></h1>

<div class="row">
  <div class="col-12 col-lg-8">
    <form id="form-cliente" method="post" action="<%= acao %>" novalidate>
      <div class="row g-3">

        <div class="col-12">
          <label for="nome" class="form-label">Nome completo</label>
          <input type="text" id="nome" name="nome" maxlength="100"
                 class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
                 value="<%= cliente.nome || '' %>">
          <div class="invalid-feedback"><%= erros.nome || '' %></div>
        </div>

        <div class="col-12 col-md-6">
          <label for="email" class="form-label">E-mail</label>
          <input type="email" id="email" name="email" maxlength="100"
                 class="form-control <%= erros.email ? 'is-invalid' : '' %>"
                 value="<%= cliente.email || '' %>">
          <div class="invalid-feedback"><%= erros.email || '' %></div>
        </div>

        <div class="col-12 col-md-6">
          <label for="cpf" class="form-label">CPF</label>
          <input type="text" id="cpf" name="cpf" inputmode="numeric" placeholder="000.000.000-00"
                 class="form-control <%= erros.cpf ? 'is-invalid' : '' %>"
                 value="<%= cliente.cpf || '' %>">
          <div class="invalid-feedback"><%= erros.cpf || '' %></div>
        </div>

        <div class="col-12 col-md-4">
          <label for="data_nascimento" class="form-label">Data de nascimento</label>
          <input type="date" id="data_nascimento" name="data_nascimento"
                 class="form-control <%= erros.data_nascimento ? 'is-invalid' : '' %>"
                 value="<%= cliente.data_nascimento || '' %>">
          <div class="invalid-feedback"><%= erros.data_nascimento || '' %></div>
        </div>

        <div class="col-12 col-md-4">
          <label for="cep" class="form-label">CEP</label>
          <input type="text" id="cep" name="cep" inputmode="numeric" placeholder="00000-000"
                 class="form-control <%= erros.cep ? 'is-invalid' : '' %>"
                 value="<%= cliente.cep || '' %>">
          <div class="invalid-feedback"><%= erros.cep || '' %></div>
        </div>

        <div class="col-12 col-md-4">
          <label for="categoria" class="form-label">Categoria</label>
          <select id="categoria" name="categoria"
                  class="form-select <%= erros.categoria ? 'is-invalid' : '' %>">
            <option value="">Selecione...</option>
            <% categorias.forEach(cat => { %>
              <option value="<%= cat %>" <%= cliente.categoria === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback"><%= erros.categoria || '' %></div>
        </div>

        <div class="col-12 col-md-4">
          <label for="limite_credito" class="form-label">Limite de crédito (R$)</label>
          <input type="number" id="limite_credito" name="limite_credito" step="0.01" min="0"
                 class="form-control <%= erros.limite_credito ? 'is-invalid' : '' %>"
                 value="<%= cliente.limite_credito ?? '' %>">
          <div class="invalid-feedback"><%= erros.limite_credito || '' %></div>
        </div>

      </div>

      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-rosa">Salvar</button>
        <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer', { scriptPagina: '/js/validacao.js' }) %>